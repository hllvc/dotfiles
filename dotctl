#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob

readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly LAUNCH_AGENTS_SOURCE="$HOME/.config/launch-agents"
readonly CRONS_DIR="$REPO_ROOT/.shell/scripts/crons"
readonly LINK_SKILLS="$CRONS_DIR/homebrew-update/link-skills.sh"
readonly MACOS_SCRIPT="$REPO_ROOT/.shell/scripts/macos/defaults.sh"
readonly TF_PLUGIN_CACHE="$HOME/.terraform.d/plugin-cache"
readonly VERSIONS_FILE="$REPO_ROOT/.versions"
readonly REQUIRED_TOOLS=("brew" "stow")

# A broken link is "ours" if its target path passes through the dotfiles
# directory — that covers every worktree plus any old backup copy of it.
readonly DOTFILES_MARKER="$(basename "$(dirname "$REPO_ROOT")")"

# Subtrees skipped when hunting orphans: too big to be worth walking, or full
# of links that are supposed to dangle.
readonly ORPHAN_PRUNE=(
  Library .Trash .repos Applications node_modules .git
  Movies Music Pictures .npm .pnpm-store .cargo .rustup
  .orbstack .docker .gradle .m2 go
)

# ─── Help ──────────────────────────────────────────────────────────────── {{{

usage() {
  cat <<EOF
Usage: ./dotctl <command> [options]

Running without a command prints this help. Every action is explicit.

Commands:
  all                        Run stow, load launch agents, install crons,
                             apply macOS defaults
  stow        [--adopt]      Symlink dotfiles into \$HOME via stow
  agents      <load|unload|disable|enable|list> [name...]
                             Manage launch agents under ~/.config/launch-agents
                             (all of them, or just the named ones)
  crons       <install|list>
                             Orchestrate per-cron install.sh hooks under
                             .shell/scripts/crons/*/install.sh
  macos       <apply>        Apply macOS \`defaults write\` tweaks
                             (.shell/scripts/macos/defaults.sh)
  doctor                     Audit plists/scripts for worktree-pinned or
                             missing absolute paths
  orphans     [--fix]        Report symlinks in \$HOME left behind by renamed
                             or removed repo files
  versions    [status|accept|upgrade|pins|auto]
                             Compare installed tool versions with the ones
                             recorded in .versions

Global:
  -h, --help                 Show this help

Per-command help:
  ./dotctl <command> -h

Examples:
  ./dotctl all              # stow + agents load + crons install + macos apply
  ./dotctl stow --adopt     # adopt existing files as stow-managed
  ./dotctl agents unload    # unload all launch agents
  ./dotctl agents disable homebrew-update  # unload + keep it off for good
  ./dotctl crons list       # list discovered cron install hooks
  ./dotctl macos apply      # apply macOS defaults tweaks
  ./dotctl doctor           # audit absolute paths in plists + scripts
  ./dotctl orphans          # report dangling dotfile symlinks
  ./dotctl orphans --fix    # ...and delete the ones pointing at this repo
  ./dotctl versions         # what drifted since the config was last checked
EOF
}

usage_stow() {
  cat <<EOF
Usage: ./dotctl stow [--adopt]

Symlinks this repo into \$HOME via GNU stow. Cleans stale symlinks first so
renamed/removed files don't linger. Afterwards links Homebrew-shipped Claude
skills (e.g. terminal-browser) into ~/.claude/skills via
.shell/scripts/crons/homebrew-update/link-skills.sh — those point at
version-pinned Caskroom paths, so they're kept out of the repo and out of stow.

Options:
  --adopt    Run \`stow --adopt\`: files already in \$HOME that shadow repo files
             get moved into the repo and replaced with symlinks. Use with care
             — review \`git status\` afterwards.
EOF
}

usage_agents() {
  cat <<EOF
Usage: ./dotctl agents <load|unload|disable|enable|list> [name...]

Manages user LaunchAgents. Each *.plist in ~/.config/launch-agents/ is
symlinked into ~/Library/LaunchAgents/ and bootstrapped via launchctl.

Subcommands:
  load       Symlink plists and bootstrap (no-op if already loaded; skips
             disabled agents)
  unload     Bootout and remove the symlinks — until the next \`load\`/\`all\`
  disable    Unload, then mark the label disabled in launchd so \`load\`,
             \`all\` and reboots leave it off. The plist stays in the repo.
  enable     Clear the disabled mark and load
  list       Show each plist + whether it's loaded, unloaded or disabled

Names:
  With no names every plist is acted on. Otherwise each name may be the full
  label, the plist filename, or the short suffix after the reverse-DNS prefix:
    com.hllvc.tmux-autosave  com.hllvc.tmux-autosave.plist  tmux-autosave
  An unknown or ambiguous name aborts before anything is touched.

Examples:
  ./dotctl agents unload tmux-autosave
  ./dotctl agents load com.hllvc.work.tmux com.hllvc.personal.tmux
  ./dotctl agents list memory-pressure
  ./dotctl agents disable homebrew-update
EOF
}

usage_crons() {
  cat <<EOF
Usage: ./dotctl crons <install|list>

Orchestrates per-cron install hooks. Any .shell/scripts/crons/*/install.sh
is auto-discovered; drop a new cron folder with its own install.sh and it
will be picked up on the next run.

Subcommands:
  install    Run every discovered install.sh (may prompt for sudo)
  list       Show discovered cron dirs and whether they have install.sh

Notes:
  - install.sh is invoked with cwd set to its own directory.
  - Failures in one script do not abort the others; exit code reflects
    whether any failed.
EOF
}

usage_orphans() {
  cat <<EOF
Usage: ./dotctl orphans [--fix]

Finds dangling symlinks in \$HOME. \`stow\` cleans stale links for files that
still exist in the repo, but a file that was *renamed or deleted* leaves a
link nothing ever visits again — this finds those.

Reports three groups:
  REPO     broken, and the target path contains "$DOTFILES_MARKER" — ours, safe to delete
  FOREIGN  broken, pointing elsewhere — never touched, only listed. Wine drive
           mappings and app caches live here and are usually meant to dangle.
  STALE    resolves fine, but lands on a repo path git no longer tracks

Options:
  --fix    Delete the REPO group, then rmdir any parent directories the
           deletion left empty. FOREIGN and STALE are never auto-deleted.
EOF
}

usage_macos() {
  cat <<EOF
Usage: ./dotctl macos <apply>

Applies personal macOS \`defaults write\` tweaks (Finder, Dock, trackpad,
keyboard, Safari, Mail, …) defined in:
  .shell/scripts/macos/defaults.sh

Subcommands:
  apply      Run the defaults script. Idempotent. Relaunches Dock, Finder,
             SystemUIServer, and cfprefsd so changes take effect immediately.

Notes:
  - No-op on non-Darwin systems.
  - Safari and Mail prefs are sandboxed: they need Full Disk Access for the
    terminal app, and don't work inside tmux started by launchd (the
    tmux server, not the terminal, is what macOS checks). Skipped sections
    are reported and make the command exit non-zero.
  - Edit the script directly to add/remove tweaks; it IS the documentation.
EOF
}

# }}}

# ─── Helpers ───────────────────────────────────────────────────────────── {{{

_command_installed() {
  command -v "$1" &>/dev/null
}

_install_brew() {
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew update
}

_require_tools() {
  for tool in "${REQUIRED_TOOLS[@]}"; do
    if ! _command_installed "$tool" && [[ "$tool" == "brew" ]]; then
      _install_brew
    elif ! _command_installed "$tool"; then
      brew install "$tool"
    fi
  done
}

_clean_stale_symlinks() {
  local pkg resolved rel home_path
  pkg="$REPO_ROOT"

  while IFS= read -r -d '' entry; do
    rel="${entry#$pkg/}"
    home_path="$HOME/$rel"
    [[ -L "$home_path" ]] || continue
    resolved=$(readlink -f "$home_path" 2>/dev/null || true)
    if [[ "$resolved" != "$entry" ]]; then
      rm -v "$home_path"
    fi
  done < <(find "$pkg" -mindepth 1 \
    \( -path "$pkg/.git" -o -path "$pkg/.git/*" \) -prune -o \
    \( -type f -o -type d \) -print0)
}

_agent_is_loaded() {
  local label="$1" uid
  uid=$(id -u)
  launchctl print "gui/$uid/$label" &>/dev/null
}

# launchd keeps a per-domain override list; a disabled label refuses
# bootstrap. Older macOS prints "=> true" instead of "=> disabled".
_agent_is_disabled() {
  local label="$1" uid
  uid=$(id -u)
  launchctl print-disabled "gui/$uid" 2>/dev/null |
    grep -Eq "\"${label//./\\.}\" => (disabled|true)"
}

# Resolve agent names to plist paths, one per line. No names → every plist.
# A name may be the full label, the plist filename, or a short suffix
# (e.g. "tmux-autosave" for com.hllvc.tmux-autosave). Unknown or ambiguous
# names fail the whole resolve so nothing is half-applied.
_agents_resolve() {
  local -a files=()
  if [[ $# -eq 0 ]]; then
    files=("$LAUNCH_AGENTS_SOURCE"/*.plist)
  else
    local name rc=0
    local -a matches
    for name in "$@"; do
      name="${name%.plist}"
      if [[ -f "$LAUNCH_AGENTS_SOURCE/$name.plist" ]]; then
        files+=("$LAUNCH_AGENTS_SOURCE/$name.plist")
        continue
      fi
      matches=("$LAUNCH_AGENTS_SOURCE"/*."$name".plist)
      case ${#matches[@]} in
      1) files+=("${matches[0]}") ;;
      0)
        echo "agents: no such agent: $name" >&2
        rc=1
        ;;
      *)
        echo "agents: ambiguous name '$name', matches:" >&2
        printf '  %s\n' "${matches[@]##*/}" >&2
        rc=1
        ;;
      esac
    done
    ((rc == 0)) || return 1
  fi
  printf '%s\n' "${files[@]}"
}

# Fill the caller's `files` array (dynamic scope) from _agents_resolve.
# Goes through a variable rather than a process substitution so a resolve
# failure actually propagates.
_agents_select() {
  local out line
  out=$(_agents_resolve "$@") || return 1
  [[ -n "$out" ]] || {
    echo "agents: no plists in $LAUNCH_AGENTS_SOURCE" >&2
    return 1
  }
  while IFS= read -r line; do files+=("$line"); done <<<"$out"
}

# terraform/opentofu refuse to create plugin_cache_dir themselves — a missing
# directory means caching is silently skipped, so make sure it exists.
_ensure_plugin_cache_dir() {
  [[ -d "$TF_PLUGIN_CACHE" ]] || mkdir -pv "$TF_PLUGIN_CACHE"
}

# }}}

# ─── stow ──────────────────────────────────────────────────────────────── {{{

cmd_stow() {
  local adopt=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --adopt)
      adopt=1
      shift
      ;;
    -h | --help)
      usage_stow
      return 0
      ;;
    *)
      echo "stow: unknown option: $1" >&2
      usage_stow >&2
      return 1
      ;;
    esac
  done

  _require_tools
  _clean_stale_symlinks
  _ensure_plugin_cache_dir

  if ((adopt)); then
    stow -v -t "$HOME" -d "$REPO_ROOT" . --adopt
  else
    stow -v -t "$HOME" -d "$REPO_ROOT" .
  fi

  echo "── brew skills ──"
  bash "$LINK_SKILLS" || echo "  (some skill links failed — see above)"
}

# }}}

# ─── agents ────────────────────────────────────────────────────────────── {{{

_agents_load() {
  [[ -d "$LAUNCH_AGENTS_SOURCE" ]] || {
    echo "No launch-agents dir; skipping."
    return 0
  }

  local -a files
  _agents_select "$@" || return 1

  local uid filename label file
  uid=$(id -u)

  for file in "${files[@]}"; do
    filename=$(basename "$file")
    label="${filename%.plist}"
    if _agent_is_disabled "$label"; then
      echo "  $label: disabled — skipped (./dotctl agents enable ${label#com.*.})"
      continue
    fi
    ln -sfv "$file" "$HOME/Library/LaunchAgents/$filename"
    if _agent_is_loaded "$label"; then
      echo "  $label: already loaded"
    else
      launchctl bootstrap "gui/$uid" "$HOME/Library/LaunchAgents/$filename" &&
        echo "  $label: loaded" ||
        echo "  $label: bootstrap failed"
    fi
  done
}

_agents_unload() {
  [[ -d "$LAUNCH_AGENTS_SOURCE" ]] || {
    echo "No launch-agents dir; skipping."
    return 0
  }

  local -a files
  _agents_select "$@" || return 1

  local uid filename label file
  uid=$(id -u)

  for file in "${files[@]}"; do
    filename=$(basename "$file")
    label="${filename%.plist}"
    if [[ -e "$HOME/Library/LaunchAgents/$filename" || -L "$HOME/Library/LaunchAgents/$filename" ]]; then
      launchctl bootout "gui/$uid/$label" ||
        echo "  note: $label may already be unloaded"
      rm -fv "$HOME/Library/LaunchAgents/$filename"
    else
      echo "  $label: not installed"
    fi
  done
}

_agents_disable() {
  [[ -d "$LAUNCH_AGENTS_SOURCE" ]] || {
    echo "No launch-agents dir; skipping."
    return 0
  }

  local -a files
  _agents_select "$@" || return 1

  local uid label file
  uid=$(id -u)

  _agents_unload "$@"
  for file in "${files[@]}"; do
    label="$(basename "$file" .plist)"
    launchctl disable "gui/$uid/$label" &&
      echo "  $label: disabled" ||
      echo "  $label: disable failed"
  done
}

_agents_enable() {
  [[ -d "$LAUNCH_AGENTS_SOURCE" ]] || {
    echo "No launch-agents dir; skipping."
    return 0
  }

  local -a files
  _agents_select "$@" || return 1

  local uid label file
  uid=$(id -u)

  for file in "${files[@]}"; do
    label="$(basename "$file" .plist)"
    launchctl enable "gui/$uid/$label" &&
      echo "  $label: enabled" ||
      echo "  $label: enable failed"
  done
  _agents_load "$@"
}

_agents_list() {
  [[ -d "$LAUNCH_AGENTS_SOURCE" ]] || {
    echo "No launch-agents dir."
    return 0
  }

  local -a files
  _agents_select "$@" || return 1

  local filename label status file
  printf '%-40s %s\n' "LABEL" "STATUS"
  printf '%-40s %s\n' "-----" "------"
  for file in "${files[@]}"; do
    filename=$(basename "$file")
    label="${filename%.plist}"
    if _agent_is_loaded "$label"; then
      status="loaded"
    elif _agent_is_disabled "$label"; then
      status="disabled"
    else
      status="unloaded"
    fi
    printf '%-40s %s\n' "$label" "$status"
  done
}

cmd_agents() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || {
    usage_agents >&2
    return 1
  }
  shift
  case "$sub" in
  load) _agents_load "$@" ;;
  unload) _agents_unload "$@" ;;
  disable) _agents_disable "$@" ;;
  enable) _agents_enable "$@" ;;
  list) _agents_list "$@" ;;
  -h | --help) usage_agents ;;
  *)
    echo "agents: unknown subcommand: $sub" >&2
    usage_agents >&2
    return 1
    ;;
  esac
}

# }}}

# ─── crons ─────────────────────────────────────────────────────────────── {{{

_discover_crons() {
  [[ -d "$CRONS_DIR" ]] || return 0
  for dir in "$CRONS_DIR"/*/; do
    [[ -d "$dir" ]] && printf '%s\n' "${dir%/}"
  done
}

_crons_install() {
  local dir name install_path failed=0 ran=0
  while IFS= read -r dir; do
    name=$(basename "$dir")
    install_path="$dir/install.sh"
    if [[ -x "$install_path" || -f "$install_path" ]]; then
      echo "── installing cron: $name ──"
      if (cd "$dir" && bash "$install_path"); then
        ran=$((ran + 1))
      else
        echo "  ✗ $name/install.sh failed" >&2
        failed=$((failed + 1))
      fi
    fi
  done < <(_discover_crons)

  echo
  echo "Cron install summary: $ran succeeded, $failed failed."
  return "$failed"
}

_crons_list() {
  local dir name
  printf '%-30s %s\n' "CRON" "HAS install.sh"
  printf '%-30s %s\n' "----" "--------------"
  while IFS= read -r dir; do
    name=$(basename "$dir")
    if [[ -f "$dir/install.sh" ]]; then
      printf '%-30s %s\n' "$name" "yes"
    else
      printf '%-30s %s\n' "$name" "no"
    fi
  done < <(_discover_crons)
}

cmd_crons() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || {
    usage_crons >&2
    return 1
  }
  shift
  case "$sub" in
  install) _crons_install ;;
  list) _crons_list ;;
  -h | --help) usage_crons ;;
  *)
    echo "crons: unknown subcommand: $sub" >&2
    usage_crons >&2
    return 1
    ;;
  esac
}

# }}}

# ─── macos ─────────────────────────────────────────────────────────────── {{{

_macos_apply() {
  [[ "$(uname -s)" == "Darwin" ]] || {
    echo "macos: skipping — not on Darwin"
    return 0
  }
  [[ -f "$MACOS_SCRIPT" ]] || {
    echo "macos: $MACOS_SCRIPT not found" >&2
    return 1
  }
  bash "$MACOS_SCRIPT"
}

cmd_macos() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || {
    usage_macos >&2
    return 1
  }
  shift
  case "$sub" in
  apply) _macos_apply ;;
  -h | --help) usage_macos ;;
  *)
    echo "macos: unknown subcommand: $sub" >&2
    usage_macos >&2
    return 1
    ;;
  esac
}

# }}}

# ─── orphans ───────────────────────────────────────────────────────────── {{{

_orphan_find_links() {
  local -a prune=()
  local first=1 p
  for p in "${ORPHAN_PRUNE[@]}"; do
    if ((first)); then
      prune+=(-name "$p")
      first=0
    else
      prune+=(-o -name "$p")
    fi
  done
  find "$HOME" \( "${prune[@]}" \) -prune -o -type l -print 2>/dev/null || true
}

# Drop directories that the orphan sweep just emptied, walking upward until a
# parent is non-empty. rmdir refuses non-empty dirs, so this cannot overreach.
_orphan_prune_empty_dirs() {
  local dir="$1"
  while [[ "$dir" != "$HOME" && "$dir" == "$HOME"/* ]]; do
    rmdir "$dir" 2>/dev/null || break
    echo "  rmdir $dir"
    dir="$(dirname "$dir")"
  done
}

cmd_orphans() {
  local fix=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --fix)
      fix=1
      shift
      ;;
    -h | --help)
      usage_orphans
      return 0
      ;;
    *)
      echo "orphans: unknown option: $1" >&2
      usage_orphans >&2
      return 1
      ;;
    esac
  done

  local tracked repo_list foreign_list stale_list
  tracked=$(mktemp)
  repo_list=$(mktemp)
  foreign_list=$(mktemp)
  stale_list=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$tracked' '$repo_list' '$foreign_list' '$stale_list'" RETURN

  git -C "$REPO_ROOT" ls-files >"$tracked"

  local link tgt short real rel
  local n_repo=0 n_foreign=0 n_stale=0

  while IFS= read -r link; do
    tgt=$(readlink "$link")
    short="${link/#$HOME/\~}"

    if [[ ! -e "$link" ]]; then
      if [[ "$tgt" == *"/$DOTFILES_MARKER/"* ]]; then
        printf '%s\n' "$link" >>"$repo_list"
        n_repo=$((n_repo + 1))
      else
        printf '  %s\n      -> %s\n' "$short" "$tgt" >>"$foreign_list"
        n_foreign=$((n_foreign + 1))
      fi
      continue
    fi

    real=$(readlink -f "$link" 2>/dev/null || true)
    [[ "$real" == "$REPO_ROOT"/* ]] || continue
    rel="${real#$REPO_ROOT/}"

    # git tracks files, never directories — a directory link is healthy as
    # long as something tracked lives beneath it.
    if [[ -d "$real" ]]; then
      if grep -q "^${rel}/" "$tracked"; then continue; fi
    else
      if grep -qxF "${rel}" "$tracked"; then continue; fi
    fi
    printf '  %s\n      -> %s (in repo, untracked by git)\n' "$short" "$rel" >>"$stale_list"
    n_stale=$((n_stale + 1))
  done < <(_orphan_find_links)

  echo "REPO — broken, ours ($n_repo)"
  if ((n_repo)); then
    while IFS= read -r link; do
      printf '  %s\n      -> %s\n' "${link/#$HOME/\~}" "$(readlink "$link")"
    done <"$repo_list"
  else
    echo "  none"
  fi

  echo
  echo "FOREIGN — broken, not ours ($n_foreign)"
  ((n_foreign)) && cat "$foreign_list" || echo "  none"

  echo
  echo "STALE — live, but untracked in repo ($n_stale)"
  ((n_stale)) && cat "$stale_list" || echo "  none"

  if ((fix)) && ((n_repo)); then
    echo
    echo "── removing $n_repo orphan(s) ──"
    while IFS= read -r link; do
      rm -v "$link"
      _orphan_prune_empty_dirs "$(dirname "$link")"
    done <"$repo_list"
  elif ((n_repo)); then
    echo
    echo "Re-run with --fix to delete the REPO group."
  fi
}

# }}}

# ─── doctor ────────────────────────────────────────────────────────────── {{{

usage_doctor() {
  cat <<EOF
Usage: ./dotctl doctor

Audits config that points into this repo by absolute path.

launchd does no variable expansion, so a plist *must* carry an absolute path —
but it should point at the stable stowed location (\$HOME/.shell/...), not at
.repos/private/dotfiles/<worktree>/.shell/... A plist pinned to a worktree dies
the moment that worktree is renamed, and launchd reports it only as exit 78 in
a log nobody reads.

Checks:
  WORKTREE-PINNED  a plist or script naming a worktree path instead of the
                   stowed one — works today, breaks on rename
  MISSING PATH     a plist referencing a path that does not exist — the
                   breakage itself, whatever caused it

Exits non-zero if anything is flagged.
EOF
}

# Absolute <string> values in a plist, minus log paths (created on first run)
# and PATH-style lists (colon-joined, not a single path).
_doctor_plist_paths() {
  sed -n 's|.*<string>\(/[^<]*\)</string>.*|\1|p' "$1" |
    grep -v ':' | grep -v '/Library/Logs/' || true
}

cmd_doctor() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage_doctor
      return 0
      ;;
    *)
      echo "doctor: unknown option: $1" >&2
      usage_doctor >&2
      return 1
      ;;
    esac
  done

  local -i issues=0 n_plists=0 n_files=0 sec=0
  local plist name p

  echo "── launch agents ──"
  if [[ ! -d "$LAUNCH_AGENTS_SOURCE" ]]; then
    echo "  $LAUNCH_AGENTS_SOURCE does not exist — nothing checked"
  else
    for plist in "$LAUNCH_AGENTS_SOURCE"/*.plist; do
      n_plists+=1
      name="$(basename "$plist")"

      while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        echo "  WORKTREE-PINNED  $name"
        echo "    $p"
        echo "    -> point at \$HOME/.shell/... instead (stow keeps that stable)"
        sec+=1
      done < <(_doctor_plist_paths "$plist" | grep -F "/.repos/" || true)

      while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        [[ -e "$p" ]] && continue
        echo "  MISSING PATH     $name"
        echo "    $p"
        sec+=1
      done < <(_doctor_plist_paths "$plist")
    done
    printf '  %d plist(s) checked, %d issue(s)\n' "$n_plists" "$sec"
  fi
  issues+=$sec

  echo
  echo "── scripts ──"
  sec=0
  local f hit
  while IFS= read -r -d '' f; do
    n_files+=1
    while IFS= read -r hit; do
      [[ -n "$hit" ]] || continue
      echo "  WORKTREE-PINNED  ${f#"$REPO_ROOT"/}"
      echo "    $hit"
      sec+=1
    done < <(grep -n "/\.repos/private/dotfiles/" "$f" || true)
  done < <(/usr/bin/find "$REPO_ROOT/.shell" "$REPO_ROOT/.sleep" \
    -type f \( -name '*.sh' -o -name '.sleep' \) -print0 2>/dev/null)
  printf '  %d file(s) checked, %d issue(s)\n' "$n_files" "$sec"
  issues+=$sec

  echo
  if ((issues)); then
    echo "$issues issue(s) found."
    return 1
  fi
  # A doctor that inspected nothing must not report success.
  if ((n_plists == 0 && n_files == 0)); then
    echo "Nothing was checked — setup looks incomplete."
    return 1
  fi
  printf 'All clear (%d plists, %d scripts).\n' "$n_plists" "$n_files"
}

