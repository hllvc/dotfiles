# ─── orphans ───────────────────────────────────────────────────────────── {{{

_orphan_find_links() {
  local -a prune=()
  local first=1 p
  for p in "${ORPHAN_PRUNE[@]}"; do
    if ((first)); then
      prune+=(-name "$p")
      first=0
    else
      prune+=(-o -name "$p")
    fi
  done
  find "$HOME" \( "${prune[@]}" \) -prune -o -type l -print 2>/dev/null || true
}

# Drop directories that the orphan sweep just emptied, walking upward until a
# parent is non-empty. rmdir refuses non-empty dirs, so this cannot overreach.
_orphan_prune_empty_dirs() {
  local dir="$1"
  while [[ "$dir" != "$HOME" && "$dir" == "$HOME"/* ]]; do
    rmdir "$dir" 2>/dev/null || break
    echo "  rmdir $dir"
    dir="$(dirname "$dir")"
  done
}

cmd_orphans() {
  local fix=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --fix)
      fix=1
      shift
      ;;
    -h | --help)
      usage_orphans
      return 0
      ;;
    *)
      echo "orphans: unknown option: $1" >&2
      usage_orphans >&2
      return 1
      ;;
    esac
  done

  local tracked repo_list foreign_list stale_list
  tracked=$(mktemp)
  repo_list=$(mktemp)
  foreign_list=$(mktemp)
  stale_list=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$tracked' '$repo_list' '$foreign_list' '$stale_list'" RETURN

  git -C "$REPO_ROOT" ls-files >"$tracked"

  local link tgt short real rel
  local n_repo=0 n_foreign=0 n_stale=0

  while IFS= read -r link; do
    tgt=$(readlink "$link")
    short="${link/#$HOME/\~}"

    if [[ ! -e "$link" ]]; then
      if [[ "$tgt" == *"/$DOTFILES_MARKER/"* ]]; then
        printf '%s\n' "$link" >>"$repo_list"
        n_repo=$((n_repo + 1))
      else
        printf '  %s\n      -> %s\n' "$short" "$tgt" >>"$foreign_list"
        n_foreign=$((n_foreign + 1))
      fi
      continue
    fi

    real=$(readlink -f "$link" 2>/dev/null || true)
    [[ "$real" == "$REPO_ROOT"/* ]] || continue
    rel="${real#$REPO_ROOT/}"

    # git tracks files, never directories — a directory link is healthy as
    # long as something tracked lives beneath it.
    if [[ -d "$real" ]]; then
      if grep -q "^${rel}/" "$tracked"; then continue; fi
    else
      if grep -qxF "${rel}" "$tracked"; then continue; fi
    fi
    printf '  %s\n      -> %s (in repo, untracked by git)\n' "$short" "$rel" >>"$stale_list"
    n_stale=$((n_stale + 1))
  done < <(_orphan_find_links)

  echo "REPO — broken, ours ($n_repo)"
  if ((n_repo)); then
    while IFS= read -r link; do
      printf '  %s\n      -> %s\n' "${link/#$HOME/\~}" "$(readlink "$link")"
    done <"$repo_list"
  else
    echo "  none"
  fi

  echo
  echo "FOREIGN — broken, not ours ($n_foreign)"
  ((n_foreign)) && cat "$foreign_list" || echo "  none"

  echo
  echo "STALE — live, but untracked in repo ($n_stale)"
  ((n_stale)) && cat "$stale_list" || echo "  none"

  if ((fix)) && ((n_repo)); then
    echo
    echo "── removing $n_repo orphan(s) ──"
    while IFS= read -r link; do
      rm -v "$link"
      _orphan_prune_empty_dirs "$(dirname "$link")"
    done <"$repo_list"
  elif ((n_repo)); then
    echo
    echo "Re-run with --fix to delete the REPO group."
  fi
}

# }}}

# ─── doctor ────────────────────────────────────────────────────────────── {{{

usage_doctor() {
  cat <<EOF
Usage: ./dotctl doctor

Audits config that points into this repo by absolute path.

launchd does no variable expansion, so a plist *must* carry an absolute path —
but it should point at the stable stowed location (\$HOME/.shell/...), not at
.repos/private/dotfiles/<worktree>/.shell/... A plist pinned to a worktree dies
the moment that worktree is renamed, and launchd reports it only as exit 78 in
a log nobody reads.

Checks:
  WORKTREE-PINNED  a plist or script naming a worktree path instead of the
                   stowed one — works today, breaks on rename
  MISSING PATH     a plist referencing a path that does not exist — the
                   breakage itself, whatever caused it

Exits non-zero if anything is flagged.
EOF
}

# Absolute <string> values in a plist, minus log paths (created on first run)
# and PATH-style lists (colon-joined, not a single path).
_doctor_plist_paths() {
  sed -n 's|.*<string>\(/[^<]*\)</string>.*|\1|p' "$1" |
    grep -v ':' | grep -v '/Library/Logs/' || true
}

cmd_doctor() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage_doctor
      return 0
      ;;
    *)
      echo "doctor: unknown option: $1" >&2
      usage_doctor >&2
      return 1
      ;;
    esac
  done

  local -i issues=0 n_plists=0 n_files=0 sec=0
  local plist name p

  echo "── launch agents ──"
  if [[ ! -d "$LAUNCH_AGENTS_SOURCE" ]]; then
    echo "  $LAUNCH_AGENTS_SOURCE does not exist — nothing checked"
  else
    for plist in "$LAUNCH_AGENTS_SOURCE"/*.plist; do
      n_plists+=1
      name="$(basename "$plist")"

      while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        echo "  WORKTREE-PINNED  $name"
        echo "    $p"
        echo "    -> point at \$HOME/.shell/... instead (stow keeps that stable)"
        sec+=1
      done < <(_doctor_plist_paths "$plist" | grep -F "/.repos/" || true)

      while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        [[ -e "$p" ]] && continue
        echo "  MISSING PATH     $name"
        echo "    $p"
        sec+=1
      done < <(_doctor_plist_paths "$plist")
    done
    printf '  %d plist(s) checked, %d issue(s)\n' "$n_plists" "$sec"
  fi
  issues+=$sec

  echo
  echo "── scripts ──"
  sec=0
  local f hit
  while IFS= read -r -d '' f; do
    n_files+=1
    while IFS= read -r hit; do
      [[ -n "$hit" ]] || continue
      echo "  WORKTREE-PINNED  ${f#"$REPO_ROOT"/}"
      echo "    $hit"
      sec+=1
    done < <(grep -n "/\.repos/private/dotfiles/" "$f" || true)
  done < <(/usr/bin/find "$REPO_ROOT/.shell" "$REPO_ROOT/.sleep" \
    -type f \( -name '*.sh' -o -name '.sleep' \) -print0 2>/dev/null)
  printf '  %d file(s) checked, %d issue(s)\n' "$n_files" "$sec"
  issues+=$sec

  echo
  if ((issues)); then
    echo "$issues issue(s) found."
    return 1
  fi
  # A doctor that inspected nothing must not report success.
  if ((n_plists == 0 && n_files == 0)); then
    echo "Nothing was checked — setup looks incomplete."
    return 1
  fi
  printf 'All clear (%d plists, %d scripts).\n' "$n_plists" "$n_files"
}

# }}}

# ─── all ───────────────────────────────────────────────────────────────── {{{

cmd_all() {
  cmd_stow "$@"
  echo
  _agents_load
  echo
  _crons_install || echo "  (some cron installs failed — see above)"
  echo
  _macos_apply || echo "  (macos apply failed — see above)"
}

# }}}

# ─── dispatch ──────────────────────────────────────────────────────────── {{{

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  local cmd="$1"
  shift

  case "$cmd" in
  all) cmd_all "$@" ;;
  stow) cmd_stow "$@" ;;
  agents) cmd_agents "$@" ;;
  crons) cmd_crons "$@" ;;
  macos) cmd_macos "$@" ;;
  orphans) cmd_orphans "$@" ;;
  doctor) cmd_doctor "$@" ;;
  -h | --help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"

