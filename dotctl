# ─── orphans ───────────────────────────────────────────────────────────── {{{

_orphan_find_links() {
  local -a prune=()
  local first=1 p
  for p in "${ORPHAN_PRUNE[@]}"; do
    if ((first)); then
      prune+=(-name "$p")
      first=0
    else
      prune+=(-o -name "$p")
    fi
  done
  find "$HOME" \( "${prune[@]}" \) -prune -o -type l -print 2>/dev/null || true
}

# Drop directories that the orphan sweep just emptied, walking upward until a
# parent is non-empty. rmdir refuses non-empty dirs, so this cannot overreach.
_orphan_prune_empty_dirs() {
  local dir="$1"
  while [[ "$dir" != "$HOME" && "$dir" == "$HOME"/* ]]; do
    rmdir "$dir" 2>/dev/null || break
    echo "  rmdir $dir"
    dir="$(dirname "$dir")"
  done
}

cmd_orphans() {
  local fix=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --fix)
      fix=1
      shift
      ;;
    -h | --help)
      usage_orphans
      return 0
      ;;
    *)
      echo "orphans: unknown option: $1" >&2
      usage_orphans >&2
      return 1
      ;;
    esac
  done

  local tracked repo_list foreign_list stale_list
  tracked=$(mktemp)
  repo_list=$(mktemp)
  foreign_list=$(mktemp)
  stale_list=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$tracked' '$repo_list' '$foreign_list' '$stale_list'" RETURN

  git -C "$REPO_ROOT" ls-files >"$tracked"

  local link tgt short real rel
  local n_repo=0 n_foreign=0 n_stale=0

  while IFS= read -r link; do
    tgt=$(readlink "$link")
    short="${link/#$HOME/\~}"

    if [[ ! -e "$link" ]]; then
      if [[ "$tgt" == *"/$DOTFILES_MARKER/"* ]]; then
        printf '%s\n' "$link" >>"$repo_list"
        n_repo=$((n_repo + 1))
      else
        printf '  %s\n      -> %s\n' "$short" "$tgt" >>"$foreign_list"
        n_foreign=$((n_foreign + 1))
      fi
      continue
    fi

    real=$(readlink -f "$link" 2>/dev/null || true)
    [[ "$real" == "$REPO_ROOT"/* ]] || continue
    rel="${real#$REPO_ROOT/}"

    # git tracks files, never directories — a directory link is healthy as
    # long as something tracked lives beneath it.
    if [[ -d "$real" ]]; then
      if grep -q "^${rel}/" "$tracked"; then continue; fi
    else
      if grep -qxF "${rel}" "$tracked"; then continue; fi
    fi
    printf '  %s\n      -> %s (in repo, untracked by git)\n' "$short" "$rel" >>"$stale_list"
    n_stale=$((n_stale + 1))
  done < <(_orphan_find_links)

  echo "REPO — broken, ours ($n_repo)"
  if ((n_repo)); then
    while IFS= read -r link; do
      printf '  %s\n      -> %s\n' "${link/#$HOME/\~}" "$(readlink "$link")"
    done <"$repo_list"
  else
    echo "  none"
  fi

  echo
  echo "FOREIGN — broken, not ours ($n_foreign)"
  ((n_foreign)) && cat "$foreign_list" || echo "  none"

  echo
  echo "STALE — live, but untracked in repo ($n_stale)"
  ((n_stale)) && cat "$stale_list" || echo "  none"

  if ((fix)) && ((n_repo)); then
    echo
    echo "── removing $n_repo orphan(s) ──"
    while IFS= read -r link; do
      rm -v "$link"
      _orphan_prune_empty_dirs "$(dirname "$link")"
    done <"$repo_list"
  elif ((n_repo)); then
    echo
    echo "Re-run with --fix to delete the REPO group."
  fi
}

# }}}

# ─── doctor ────────────────────────────────────────────────────────────── {{{

usage_doctor() {
  cat <<EOF
Usage: ./dotctl doctor

Audits config that points into this repo by absolute path.

launchd does no variable expansion, so a plist *must* carry an absolute path —
but it should point at the stable stowed location (\$HOME/.shell/...), not at
.repos/private/dotfiles/<worktree>/.shell/... A plist pinned to a worktree dies
the moment that worktree is renamed, and launchd reports it only as exit 78 in
a log nobody reads.

Checks:
  WORKTREE-PINNED  a plist or script naming a worktree path instead of the
                   stowed one — works today, breaks on rename
  MISSING PATH     a plist referencing a path that does not exist — the
                   breakage itself, whatever caused it
  UNREGISTERED     the claude-settings git filter is missing from repo config

Exits non-zero if anything is flagged.
EOF
}

# Absolute <string> values in a plist, minus log paths (created on first run)
# and PATH-style lists (colon-joined, not a single path).
_doctor_plist_paths() {
  sed -n 's|.*<string>\(/[^<]*\)</string>.*|\1|p' "$1" |
    grep -v ':' | grep -v '/Library/Logs/' || true
}

cmd_doctor() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage_doctor
      return 0
      ;;
    *)
      echo "doctor: unknown option: $1" >&2
      usage_doctor >&2
      return 1
      ;;
    esac
  done

  local -i issues=0 n_plists=0 n_files=0 sec=0
  local plist name p

  echo "── launch agents ──"
  if [[ ! -d "$LAUNCH_AGENTS_SOURCE" ]]; then
    echo "  $LAUNCH_AGENTS_SOURCE does not exist — nothing checked"
  else
    for plist in "$LAUNCH_AGENTS_SOURCE"/*.plist; do
      n_plists+=1
      name="$(basename "$plist")"

      while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        echo "  WORKTREE-PINNED  $name"
        echo "    $p"
        echo "    -> point at \$HOME/.shell/... instead (stow keeps that stable)"
        sec+=1
      done < <(_doctor_plist_paths "$plist" | grep -F "/.repos/" || true)

      while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        [[ -e "$p" ]] && continue
        echo "  MISSING PATH     $name"
        echo "    $p"
        sec+=1
      done < <(_doctor_plist_paths "$plist")
    done
    printf '  %d plist(s) checked, %d issue(s)\n' "$n_plists" "$sec"
  fi
  issues+=$sec

  echo
  echo "── scripts ──"
  sec=0
  local f hit
  while IFS= read -r -d '' f; do
    n_files+=1
    while IFS= read -r hit; do
      [[ -n "$hit" ]] || continue
      echo "  WORKTREE-PINNED  ${f#"$REPO_ROOT"/}"
      echo "    $hit"
      sec+=1
    done < <(grep -n "/\.repos/private/dotfiles/" "$f" || true)
  done < <(/usr/bin/find "$REPO_ROOT/.shell" "$REPO_ROOT/.sleep" \
    -type f \( -name '*.sh' -o -name '.sleep' \) -print0 2>/dev/null)
  printf '  %d file(s) checked, %d issue(s)\n' "$n_files" "$sec"
  issues+=$sec

  echo
  echo "── git filters ──"
  if git -C "$REPO_ROOT" config --get filter.claude-settings.clean >/dev/null; then
    echo "  claude-settings registered"
  else
    echo "  UNREGISTERED     filter.claude-settings"
    echo "    -> ./dotctl stow (model/effort switches will show as repo changes)"
    issues+=1
  fi

  echo
  if ((issues)); then
    echo "$issues issue(s) found."
    return 1
  fi
  # A doctor that inspected nothing must not report success.
  if ((n_plists == 0 && n_files == 0)); then
    echo "Nothing was checked — setup looks incomplete."
    return 1
  fi
  printf 'All clear (%d plists, %d scripts).\n' "$n_plists" "$n_files"
}

# }}}

# ─── versions ──────────────────────────────────────────────────────────── {{{

usage_versions() {
  cat <<EOF
Usage: ./dotctl versions [status [--brief|--issues] | review <tool...> |
                          accept <tool...|--all|--triaged> | upgrade <tool> |
                          pins | auto [-n] | accepted [--days N]]

Compares each tool's installed version with the one recorded in .versions —
the version this repo's config was last checked against. Drift is the cue to
read that tool's changes (the changes column) and adjust the config.

Subcommands:
  status     (default) Table of tested vs installed, plus the triage state
             from the versions-review agent. Exits non-zero when anything
             needs a look. --brief prints only one line per issue;
             --issues prints the table without the ok rows (nothing at all
             when everything is ok).
  review     Triage the named tools now (the manual trigger, and the only one
             for review=manual tools like claude-code): no config impact is
             accepted and committed, anything else gets a drafted plan in a
             window of the \`updates\` tmux session (personal socket).
  accept     Record the installed version as tested, dated today, and sync
             the in-file copies (.tmux.conf @target_version, nvim init.lua
             and README). --triaged takes every tool triage found no config
             impact for. Closes the tool's \`updates\` window unless run from
             inside it. Does not commit.
  upgrade    Upgrade a brew-pinned tool now: unpin, brew upgrade, pin again.
             Review its changes, then accept.
  pins       Make \`brew pin\` match the pin column. Idempotent; also part of
             \`dotctl all\`.
  auto       For brewup and the homebrew-update cron: apply upgrades of
             pinned tools that fit their pin level (patch / minor), report
             the rest as held. -n only prints what it would do.

  accepted   [--days N] Updates the versions-review agent accepted silently
             (no config impact) in the last N days (default 14), with the
             reason from each commit. Also shown under \`status\`.

Scripting (used by the versions-review agent):
  rows       Tab-separated: tool review silent tested installed available changes probe
  level      <from> <to>: major, minor or patch (the step between two versions)
  mirrors    <tool>: repo-relative files \`accept\` rewrites besides .versions

States:
  ok         installed == tested
  drift      installed != tested — review, then accept
  held       a pinned formula has a newer version waiting
  unpinned   the pin column is set but brew has the formula unpinned
  missing    the probe printed nothing (tool not installed?)
EOF
}

# Layout used when .versions is rewritten; matches the hand-aligned file.
readonly VERSIONS_FORMAT='%-25s %-9s %-11s %-6s %-7s %-6s %-47s %s\n'
# Triage results of the versions-review agent, one <tool>.json each.
readonly VERSIONS_CACHE="${VERSIONS_REVIEW_CACHE:-$HOME/Library/Caches/com.hllvc.versions-review}"
readonly VERSIONS_REVIEW_DIR="$REPO_ROOT/.shell/scripts/crons/versions-review"

_versions_require_file() {
  [[ -f "$VERSIONS_FILE" ]] || {
    echo "versions: $VERSIONS_FILE not found" >&2
    return 1
  }
}

# Data rows of .versions, comments and blank lines dropped.
_versions_rows() {
  grep -Ev '^[[:space:]]*(#|$)' "$VERSIONS_FILE" || true
}

# The row for one tool, empty when it isn't listed.
_versions_row() {
  _versions_rows | awk -v t="$1" '$1 == t'
}

# Installed version from a row's probe, run from the repo root: the first
# X.Y[.Z…] token, else the first word (a git SHA is cut to 7 chars to line up
# with `tested`). Empty when the probe fails. ~/.local/bin is added because
# launchd's PATH lacks it.
_versions_probe() {
  local out v
  out="$(cd "$REPO_ROOT" && PATH="$HOME/.local/bin:$PATH" bash -c "$1" </dev/null 2>/dev/null)" || return 0
  v="$(awk 'match($0, /[0-9]+(\.[0-9]+)+[0-9A-Za-z]*/) { print substr($0, RSTART, RLENGTH); exit }' <<<"$out")"
  if [[ -z "$v" ]]; then
    v="$(awk 'NR == 1 { print $1; exit }' <<<"$out")"
    if [[ "$v" =~ ^[0-9a-f]{7,40}$ ]]; then
      v="${v:0:7}"
    fi
  fi
  printf '%s' "$v"
}

# One line per brew-pinned tool: "<formula> <installed> <stable> <pinned 0|1>".
# stable is what `brew upgrade` would install, as of the last `brew update`.
# Batched into one call per brew command: brew is slow to start.
_versions_brew_state() {
  local -a formulae=()
  local f pin pinned listing info installed stable
  while read -r f _ _ pin _; do
    if [[ "$pin" != "-" ]]; then
      formulae+=("$f")
    fi
  done < <(_versions_rows)
  ((${#formulae[@]})) || return 0
  _command_installed brew || return 0

  pinned=" $(brew list --pinned 2>/dev/null | tr '\n' ' ') "
  listing="$(brew list --versions "${formulae[@]}" 2>/dev/null || true)"
  info="$(brew info "${formulae[@]}" 2>/dev/null |
    sed -n 's/^==> \([^:]*\): stable \([^ ,]*\).*/\1 \2/p' || true)"
  for f in "${formulae[@]}"; do
    installed="$(awk -v f="$f" '$1 == f { print $NF }' <<<"$listing")"
    installed="${installed%_*}" # drop the brew revision: 3.8_1 → 3.8
    stable="$(awk -v f="$f" '$1 == f { print $2 }' <<<"$info")"
    if [[ "$pinned" == *" $f "* ]]; then
      echo "$f ${installed:--} ${stable:--} 1"
    else
      echo "$f ${installed:--} ${stable:--} 0"
    fi
  done
}

# The newer version a pinned formula is held back from, or "-".
_versions_held() {
  local bi bs
  read -r _ bi bs _ <<<"$(awk -v f="$1" '$1 == f' <<<"$2")"
  if [[ -n "$bs" && "$bs" != "-" && "$bi" != "-" && "$bs" != "$bi" ]]; then
    echo "$bs"
  else
    echo "-"
  fi
}

# Size of the step between two versions: major, minor or patch. The first two
# numeric fields are major and minor; anything after them is patch, so
# 3.7b → 3.7c is a patch and 3.7c → 3.8 a minor.
_versions_level() {
  local a="$1" b="$2" amin=0 bmin=0
  if [[ "$a" == *.* ]]; then
    amin="${a#*.}"
    amin="${amin%%[!0-9]*}"
  fi
  if [[ "$b" == *.* ]]; then
    bmin="${b#*.}"
    bmin="${bmin%%[!0-9]*}"
  fi
  if [[ "${a%%.*}" != "${b%%.*}" ]]; then
    echo major
  elif [[ "$amin" != "$bmin" ]]; then
    echo minor
  else
    echo patch
  fi
}

# Whether a pin level lets the cron apply a step of the given size.
_versions_allows() {
  case "$1:$2" in
  patch:patch | minor:patch | minor:minor) return 0 ;;
  esac
  return 1
}

# Upgrade one pinned formula: unpin, upgrade, pin again — the pin is restored
# even when the upgrade fails, so it is never left floating.
_versions_brew_upgrade() {
  local -i rc=0
  brew unpin "$1" </dev/null 2>/dev/null || true
  brew upgrade "$1" </dev/null || rc=$?
  brew pin "$1" </dev/null || rc=$?
  return "$rc"
}

# Triage state of a tool for the range tested → target, from the agent's
# cache: "no action", "plan ready", … or "-" when nothing matches that range.
_versions_triage() {
  local tool="$1" from="$2" to="$3" installed="$4" file="$VERSIONS_CACHE/$1.json"
  [[ -f "$file" ]] && _command_installed jq || {
    echo "-"
    return 0
  }
  jq -r --arg from "$from" --arg to "$to" --arg installed "$installed" '
    if .from != $from or .to != $to then "-"
    elif .verdict == "ignore" then
      if (.accept // "") | startswith("blocked") then "no action, accept " + .accept
      elif .to != $installed then "no action, safe to upgrade"
      else "no action, accept pending" end
    elif (.plan // "") == "" then "plan pending (" + .verdict + ")"
    elif .plan == "ready" then "plan ready (" + .verdict + ")"
    elif .plan == "incomplete" then "plan incomplete (" + .verdict + ")"
    else "plan failed (" + .verdict + ")" end' "$file" 2>/dev/null || echo "-"
}

_versions_status() {
  local -i brief=0 only_issues=0 header=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --brief) brief=1 ;;
    --issues) only_issues=1 ;;
    *)
      echo "versions status: unknown option: $1" >&2
      return 1
      ;;
    esac
    shift
  done
  _versions_require_file || return 1

  local brew_state tool tested checked pin review silent changes probe installed state n held level triage
  local -i issues=0
  local -a notes review_list=()
  brew_state="$(_versions_brew_state)"

  while read -r tool tested checked pin review silent changes probe; do
    notes=()
    held="-"
    installed="$(_versions_probe "$probe")"
    if [[ -z "$installed" ]]; then
      notes+=(missing)
      ((!brief)) || echo "$tool: not found ($probe)"
    elif [[ "$installed" != "$tested" ]]; then
      notes+=(drift)
      ((!brief)) || echo "$tool: $tested → $installed"
    fi

    if [[ "$pin" != "-" ]]; then
      if ! grep -q "^$tool .* 1$" <<<"$brew_state"; then
        notes+=(unpinned)
        ((!brief)) || echo "$tool: not brew-pinned (./dotctl versions pins)"
      fi
      held="$(_versions_held "$tool" "$brew_state")"
      if [[ "$held" != "-" ]]; then
        level="$(_versions_level "$installed" "$held")"
        notes+=("held → $held ($level)")
        ((!brief)) || echo "$tool: $held available, held ($level upgrade)"
      fi
    fi

    triage=""
    if ((${#notes[@]})); then
      issues+=1
      state="${notes[0]}"
      for n in "${notes[@]:1}"; do
        state+=", $n"
      done
      if [[ "$state" != unpinned && -n "$installed" ]]; then
        review_list+=("$(printf '  %-25s %s' "$tool" "$changes")")
        if [[ "$held" != "-" ]]; then
          triage="$(_versions_triage "$tool" "$tested" "$held" "$installed")"
        else
          triage="$(_versions_triage "$tool" "$tested" "$installed" "$installed")"
        fi
        [[ "$triage" != "-" || "$review" != manual ]] || triage="(manual)"
      fi
    else
      state=ok
    fi
    if ((!brief)) && [[ "$state" != ok || $only_issues -eq 0 ]]; then
      # Header on the first printed row, so --issues stays silent when all ok.
      if ((!header)); then
        printf '%-25s %-9s %-9s %-26s %s\n' TOOL TESTED INSTALLED STATE TRIAGE
        header=1
      fi
      printf '%-25s %-9s %-9s %-26s %s\n' "$tool" "$tested" "${installed:--}" "$state" "$triage"
    fi
  done < <(_versions_rows)

  if ((!issues)); then
    if ((only_issues)); then
      echo "every tool is at its tested version"
    fi
    ((brief)) || _versions_accepted_block
    return 0
  fi
  if ((!brief)) && ((${#review_list[@]})); then
    echo
    echo "Changes to read:"
    printf '%s\n' "${review_list[@]}"
    echo
    echo "Triage now: ./dotctl versions review <tool>"
    echo "After reviewing (and adjusting the config): ./dotctl versions accept <tool>"
  fi
  if ((!brief)) && grep -q ' 0$' <<<"$brew_state"; then
    echo
    echo "Unpinned formulae: ./dotctl versions pins"
  fi
  ((brief)) || _versions_accepted_block
  return 1
}

# Silent accepts by the versions-review agent: its "fix: versions — <tool>
# <version>, no config impact" commits on main, newest first, one line each
# with the first line of the commit body (the triage summary).
_versions_accepted() {
  local days=14 h subject date tool version reason
  case "${1:-}" in
  "") ;;
  --days) days="${2:?versions accepted: --days needs a number}" ;;
  *)
    echo "versions accepted: unknown option: $1" >&2
    return 1
    ;;
  esac
  while read -r h; do
    [[ -n "$h" ]] || continue
    subject="$(git -C "$REPO_ROOT" log -1 --format=%s "$h")"
    date="$(git -C "$REPO_ROOT" log -1 --format=%cs "$h")"
    reason="$(git -C "$REPO_ROOT" log -1 --format=%b "$h" | awk 'NF { print; exit }')"
    subject="${subject#fix: versions — }"
    subject="${subject%, no config impact}"
    tool="${subject% *}"
    version="${subject##* }"
    [[ ${#reason} -le 100 ]] || reason="${reason:0:99}…"
    printf '  %s  %s  %-25s %-9s %s\n' "${h:0:7}" "$date" "$tool" "$version" "$reason"
  done < <(git -C "$REPO_ROOT" log main --since="$days days ago" --format=%H \
    --all-match --grep='^fix: versions — ' --grep=', no config impact$' 2>/dev/null)
}

# The footer `status` ends with, so silent accepts stay in view.
_versions_accepted_block() {
  local list
  list="$(_versions_accepted)"
  [[ -n "$list" ]] || return 0
  echo
  echo "Auto-accepted (no config impact) in the last 14 days — to reopen one: git revert <commit>, then ./dotctl versions review <tool>"
  printf '%s\n' "$list"
}

# Machine-readable rows for the versions-review agent: tool, review, silent,
# tested, installed (- when the probe failed), available (held version or -),
# changes, probe — tab-separated, no empty fields (read with IFS=tab merges them).
_versions_rows_tsv() {
  _versions_require_file || return 1
  local brew_state tool tested checked pin review silent changes probe installed held
  brew_state="$(_versions_brew_state)"
  while read -r tool tested checked pin review silent changes probe; do
    installed="$(_versions_probe "$probe")"
    held="-"
    if [[ "$pin" != "-" ]]; then
      held="$(_versions_held "$tool" "$brew_state")"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$tool" "$review" "$silent" "$tested" "${installed:--}" "$held" "$changes" "$probe"
  done < <(_versions_rows)
}

# Tools whose cached triage found no config impact for exactly tested →
# installed, i.e. ready to accept as they are.
_versions_triaged_tools() {
  local tool tested installed
  _command_installed jq || return 0
  while IFS=$'\t' read -r tool _ _ tested installed _ _ _; do
    [[ "$installed" != "-" && "$installed" != "$tested" && -f "$VERSIONS_CACHE/$tool.json" ]] || continue
    jq -e --arg from "$tested" --arg to "$installed" \
      '.verdict == "ignore" and .from == $from and .to == $to' \
      "$VERSIONS_CACHE/$tool.json" >/dev/null 2>&1 && echo "$tool"
  done < <(_versions_rows_tsv)
  return 0
}

_versions_accept() {
  local -a tools=() accepted=()
  local -i all=0 triaged=0
  local t row probe v
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --all) all=1 ;;
    --triaged) triaged=1 ;;
    -*)
      echo "versions accept: unknown option: $1" >&2
      return 1
      ;;
    *) tools+=("$1") ;;
    esac
    shift
  done
  _versions_require_file || return 1
  if ((all)); then
    while read -r t _; do
      tools+=("$t")
    done < <(_versions_rows)
  fi
  if ((triaged)); then
    while read -r t; do
      [[ -n "$t" ]] && tools+=("$t")
    done < <(_versions_triaged_tools)
    ((${#tools[@]})) || {
      echo "versions accept: no triaged tools waiting"
      return 0
    }
  fi
  ((${#tools[@]})) || {
    echo "versions accept: name a tool, or --all / --triaged" >&2
    return 1
  }

  # Resolve every tool before touching the file: an unknown name or a failed
  # probe aborts with nothing written.
  for t in "${tools[@]}"; do
    row="$(_versions_row "$t")"
    [[ -n "$row" ]] || {
      echo "versions accept: unknown tool: $t" >&2
      return 1
    }
    read -r _ _ _ _ _ _ _ probe <<<"$row"
    v="$(_versions_probe "$probe")"
    [[ -n "$v" ]] || {
      echo "versions accept: $t: probe printed nothing ($probe)" >&2
      return 1
    }
    accepted+=("$t $v")
  done

  local today line tool tested checked pin review silent changes pair rewritten skip='^[[:space:]]*(#|$)'
  today="$(date +%Y-%m-%d)"
  rewritten="$(
    while IFS= read -r line; do
      if [[ "$line" =~ $skip ]]; then
        printf '%s\n' "$line"
        continue
      fi
      read -r tool tested checked pin review silent changes probe <<<"$line"
      for pair in "${accepted[@]}"; do
        if [[ "${pair%% *}" == "$tool" ]]; then
          tested="${pair#* }"
          checked="$today"
        fi
      done
      # shellcheck disable=SC2059 # the format is the fixed column layout
      printf "$VERSIONS_FORMAT" "$tool" "$tested" "$checked" "$pin" "$review" "$silent" "$changes" "$probe"
    done <"$VERSIONS_FILE"
  )"
  # Overwrite in place (not mv) so the file keeps its mode.
  printf '%s\n' "$rewritten" >"$VERSIONS_FILE"

  local summary=""
  for pair in "${accepted[@]}"; do
    echo "  ${pair%% *}: tested = ${pair#* } ($today)"
    _versions_sync_mirrors "${pair%% *}" "${pair#* }"
    _versions_forget "${pair%% *}" "${pair#* }"
    summary+="${summary:+, }${pair}"
  done
  echo
  echo "Not committed. Suggested:"
  echo "  git commit -am \"fix: versions — checked against $summary\""
}

# After an accept: drop the tool's triage once it covered the accepted version
# (a held-upgrade triage beyond it stays), and close its `updates` window.
_versions_forget() {
  local file="$VERSIONS_CACHE/$1.json"
  if [[ -f "$file" ]] && _command_installed jq &&
    jq -e --arg v "$2" '.to == $v' "$file" >/dev/null 2>&1; then
    rm -f "$file" "$VERSIONS_CACHE/$1".{plan.md,plan.json,triage.1.json,triage.2.json}
  fi
  if [[ -x "$VERSIONS_REVIEW_DIR/updates.sh" ]]; then
    "$VERSIONS_REVIEW_DIR/updates.sh" close "$1" || true
  fi
}

# Repo-relative files holding an in-file copy of a tool's tested version.
_versions_mirror_files() {
  case "$1" in
  tmux) echo .tmux.conf ;;
  neovim) printf '%s\n' .config/nvim/init.lua .config/nvim/README.md ;;
  esac
}

# Keep those copies in step: places that need the number at runtime (tmux's
# status-line check, nvim's startup check) or repeat it in prose.
_versions_sync_mirrors() {
  local v="$2"
  case "$1" in
  tmux)
    _versions_sync_line "$REPO_ROOT/.tmux.conf" \
      "^set -g @target_version '[^']*'" "set -g @target_version '$v'"
    ;;
  neovim)
    _versions_sync_line "$REPO_ROOT/.config/nvim/init.lua" \
      '^vim\.g\.nvim_target_version = "[^"]*"' "vim.g.nvim_target_version = \"$v\""
    _versions_sync_line "$REPO_ROOT/.config/nvim/README.md" \
      '\*\*Targets Neovim [^*]*\*\*' "**Targets Neovim $v.**"
    ;;
  esac
}

# Replace a basic-regex match in a file, or warn when the file has no match.
_versions_sync_line() {
  local file="$1" pattern="$2" replacement="$3"
  if ! grep -q "$pattern" "$file" 2>/dev/null; then
    echo "    WARNING: ${file#"$REPO_ROOT"/} has no line matching: $pattern" >&2
    return 0
  fi
  sed -i '' "s|$pattern|$replacement|" "$file"
  echo "    synced ${file#"$REPO_ROOT"/}"
}

_versions_upgrade() {
  local tool="${1:-}" row pin changes
  [[ -n "$tool" ]] || {
    echo "versions upgrade: name a tool" >&2
    return 1
  }
  _versions_require_file || return 1
  row="$(_versions_row "$tool")"
  [[ -n "$row" ]] || {
    echo "versions upgrade: unknown tool: $tool" >&2
    return 1
  }
  read -r _ _ _ pin _ _ changes _ <<<"$row"
  [[ "$pin" != "-" ]] || {
    echo "versions upgrade: $tool isn't brew-pinned — it upgrades on its own" >&2
    return 1
  }
  _versions_brew_upgrade "$tool" || return 1
  echo
  echo "Review the changes ($changes), then: ./dotctl versions accept $tool"
}

_versions_pins() {
  _versions_require_file || return 1
  _command_installed brew || {
    echo "versions pins: brew not installed — skipped"
    return 0
  }
  local pinned tool pin
  pinned=" $(brew list --pinned 2>/dev/null | tr '\n' ' ') "
  echo "── brew pins ──"
  while read -r tool _ _ pin _; do
    if [[ "$pin" == "-" ]]; then
      if [[ "$pinned" == *" $tool "* ]]; then
        brew unpin "$tool" </dev/null && echo "  unpinned  $tool"
      fi
    elif [[ "$pinned" == *" $tool "* ]]; then
      echo "  pinned    $tool ($pin)"
    elif ! brew list --versions "$tool" </dev/null >/dev/null 2>&1; then
      echo "  skipped   $tool (not installed)"
    else
      brew pin "$tool" </dev/null && echo "  pinned    $tool ($pin, newly)"
    fi
  done < <(_versions_rows)
}

# Cron side of the pin levels: apply what a tool's pin allows, report the rest.
# -n only says what it would do.
_versions_auto() {
  local -i dry=0
  case "${1:-}" in
  "") ;;
  -n) dry=1 ;;
  *)
    echo "versions auto: unknown option: $1" >&2
    return 1
    ;;
  esac
  _versions_require_file || return 1
  local brew_state tool pin bi held level
  brew_state="$(_versions_brew_state)"
  while read -r tool _ _ pin _; do
    [[ "$pin" != "-" ]] || continue
    held="$(_versions_held "$tool" "$brew_state")"
    [[ "$held" != "-" ]] || continue
    read -r _ bi _ <<<"$(awk -v f="$tool" '$1 == f' <<<"$brew_state")"
    level="$(_versions_level "$bi" "$held")"
    if _versions_allows "$pin" "$level" && ((dry)); then
      echo "$tool: $bi → $held ($level, pin=$pin allows) — would upgrade"
    elif _versions_allows "$pin" "$level"; then
      echo "$tool: $bi → $held ($level, pin=$pin allows) — upgrading"
      _versions_brew_upgrade "$tool" || echo "$tool: upgrade failed"
    else
      echo "$tool: $held available ($level) — held by pin=$pin"
    fi
  done < <(_versions_rows)
  return 0
}

cmd_versions() {
  local sub="${1:-status}"
  [[ $# -eq 0 ]] || shift
  case "$sub" in
  status) _versions_status "$@" ;;
  --brief) _versions_status --brief "$@" ;;
  review)
    [[ $# -gt 0 ]] || {
      echo "versions review: name a tool (the daily agent covers review=auto ones)" >&2
      return 1
    }
    "$VERSIONS_REVIEW_DIR/review.sh" "$@"
    ;;
  accept) _versions_accept "$@" ;;
  upgrade) _versions_upgrade "$@" ;;
  pins) _versions_pins ;;
  auto) _versions_auto "$@" ;;
  rows) _versions_rows_tsv ;;
  level) _versions_level "${1:?versions level: two versions}" "${2:?versions level: two versions}" ;;
  mirrors) _versions_mirror_files "${1:-}" ;;
  accepted) _versions_accepted "$@" ;;
  -h | --help) usage_versions ;;
  *)
    echo "versions: unknown subcommand: $sub" >&2
    usage_versions >&2
    return 1
    ;;
  esac
}

# }}}

# ─── all ───────────────────────────────────────────────────────────────── {{{

cmd_all() {
  # cmd_stow would print its own help and return 0, and everything below would
  # then run anyway.
  case "${1:-}" in
  -h | --help)
    usage_all
    return 0
    ;;
  esac
  cmd_stow "$@"
  echo
  _agents_load
  echo
  _crons_install || echo "  (some cron installs failed — see above)"
  echo
  _macos_apply || echo "  (macos apply failed — see above)"
  echo
  _versions_pins || echo "  (versions pins failed — see above)"
}

# }}}

# ─── dispatch ──────────────────────────────────────────────────────────── {{{

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  local cmd="$1" arg
  shift

  # -h anywhere after a command means help for it, before anything runs: the
  # commands that parse their own arguments only see -h in the first position,
  # so `crons install -h` used to run the installs.
  for arg in "$@"; do
    case "$arg" in
    -h | --help)
      if declare -F "usage_$cmd" >/dev/null; then
        "usage_$cmd"
        return 0
      fi
      ;;
    esac
  done

  case "$cmd" in
  all) cmd_all "$@" ;;
  stow) cmd_stow "$@" ;;
  agents) cmd_agents "$@" ;;
  crons) cmd_crons "$@" ;;
  macos) cmd_macos "$@" ;;
  orphans) cmd_orphans "$@" ;;
  doctor) cmd_doctor "$@" ;;
  versions) cmd_versions "$@" ;;
  -h | --help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"

