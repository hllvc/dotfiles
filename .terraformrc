# Terraform CLI config. Read on every `terraform` invocation, regardless of
# shell — so the plugin cache applies to IDE/LSP and script runs too.
#
# Shared provider plugin cache: fetch each provider version once, then hardlink
# it into every working directory. Without this, each module/example dir stores
# its own copy — the AWS provider alone is ~780MB unpacked per directory.
#
# OpenTofu reads ~/.tofurc first and only falls back to this file; .tofurc is
# kept as an explicit twin so neither CLI depends on that fallback.
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"
