{
  "env": {
    "BASH_ENV": "/Users/hllvc/.local/bin/claude-shims-init.sh",
    "CLAUDE_CODE_DISABLE_ANALYTICS": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_HOOK_DEBUG": "0",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(find:*)",
      "Read(~/.repos/**)",
      "Grep(~/.repos/**)",
      "Bash(tree:*)",
      "Bash(tmux:*)",
      "Bash(aws --profile sg-prod-ro:*)",
      "Bash(op plugin run -- aws --profile sg-prod-ro:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Grep(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Grep(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Grep(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Grep(~/.netrc)",
      "Read(~/.config/op/**)",
      "Edit(~/.config/op/**)",
      "Grep(~/.config/op/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Grep(~/.claude/.credentials.json)",
      "Bash(*/.ssh/*)",
      "Bash(*/.ssh)",
      "Bash(*/.aws/*)",
      "Bash(*/.aws)",
      "Bash(*/.netrc*)",
      "Bash(*/.config/gh/*)",
      "Bash(*/.config/op/*)",
      "Bash(*/.credentials.json*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)"
    ],
    "ask": [
      "Bash(*--profile sg-prod *)",
      "Bash(*--profile sg-prod)",
      "Bash(*--profile sg-prod-us *)",
      "Bash(*--profile sg-prod-us)",
      "Bash(*AWS_PROFILE=sg-prod *)",
      "Bash(*AWS_PROFILE=sg-prod)",
      "Bash(*AWS_PROFILE=sg-prod-us *)",
      "Bash(*AWS_PROFILE=sg-prod-us)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": false,
  "disableClaudeAiConnectors": true,
  "allowedMcpServers": [],
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/hllvc/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "gist.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "stackoverflow.com",
        "api.anthropic.com",
        "api.openai.com",
        "auth.openai.com",
        "registry.opentofu.org",
        "*.amazonaws.com",
        "*.1password.com"
      ]
    }
  },
  "feedbackDrafts": "notify",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "timeFormat": "auto",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(aws s3 sync:*) in this repo's CI-driving scripts — mass artifact sync to orchestrator-resources-qa should be reviewed, not auto-approved",
      "Bash(make build-prod) — pushes to PROD ECR account 476299211833, no :latest tag safety net",
      "Bash(make build-prod) and Bash(make build-deploy-prod-*) in this repo — pushes to PROD AWS deploy targets, review rather than auto-approve",
      "Bash(aws s3 sync:*) targeting non-dev namespaces — mass artifact sync should be reviewed, not auto-approved",
      "Any aws command against profile sg-prod or sg-prod-us — production accounts, require explicit approval before the action, never auto-approve"
    ]
  },
  "voiceEnabled": true
}
