#compdef dotctl
# Completion for the dotfiles control script (~/.repos/private/dotfiles/<wt>/dotctl).
# zsh falls back to the basename for path-invoked commands, so this also
# fires for ./dotctl.

_dotctl_agent_names() {
  local dir=~/.config/launch-agents
  local -a plists labels short
  plists=($dir/*.plist(N:t:r))
  (( $#plists )) || return
  labels=($plists)
  # Short form: strip the reverse-DNS prefix (com.hllvc.tmux-autosave → tmux-autosave).
  short=(${plists#com.*.})
  # Drop names already on the line, in either form.
  local w
  for w in ${words[4,-1]}; do
    labels=(${labels:#(*.|)$w})
    short=(${short:#(${w#com.*.}|$w)})
  done
  _alternative \
    "short:agent:compadd -a short" \
    "labels:label:compadd -a labels"
}

_dotctl() {
  local -a cmds
  if (( CURRENT == 2 )); then
    cmds=(
      'all:stow + agents load + crons install + macos apply'
      'stow:symlink dotfiles into $HOME'
      'agents:manage launch agents'
      'crons:run per-cron install hooks'
      'macos:apply macOS defaults'
      'doctor:audit plists/scripts for worktree-pinned or missing paths'
      'orphans:report dangling dotfile symlinks'
      'versions:compare installed tool versions with .versions'
      '-h:help'
      '--help:help'
    )
    _describe -t commands 'dotctl command' cmds
    return
  fi

  case $words[2] in
  all | stow)
    shift words; (( CURRENT-- ))
    _arguments '--adopt[adopt existing files as stow-managed]' '(-h --help)'{-h,--help}'[help]'
    ;;
  agents)
    if (( CURRENT == 3 )); then
      cmds=(
        'load:symlink plists and bootstrap'
        'unload:bootout and remove symlinks'
        'disable:unload and keep off across load/all/reboot'
        'enable:clear disabled mark and load'
        'list:show plists and loaded state'
        '-h:help'
      )
      _describe -t commands 'agents subcommand' cmds
    else
      _dotctl_agent_names
    fi
    ;;
  crons)
    (( CURRENT == 3 )) || return
    cmds=(
      'install:run every discovered install.sh'
      'list:show cron dirs and whether they have install.sh'
      '-h:help'
    )
    _describe -t commands 'crons subcommand' cmds
    ;;
  macos)
    (( CURRENT == 3 )) || return
    cmds=('apply:run the defaults script' '-h:help')
    _describe -t commands 'macos subcommand' cmds
    ;;
  orphans)
    shift words; (( CURRENT-- ))
    _arguments '--fix[delete the REPO group]' '(-h --help)'{-h,--help}'[help]'
    ;;
  doctor)
    shift words; (( CURRENT-- ))
    _arguments '(-h --help)'{-h,--help}'[help]'
    ;;
  versions)
    if (( CURRENT == 3 )); then
      cmds=(
        'status:tested vs installed, plus triage state (default)'
        'review:triage named tools now, draft a plan if needed'
        'accept:record installed as tested, sync in-file copies'
        'upgrade:upgrade a brew-pinned tool now'
        'pins:make brew pins match the pin column'
        'auto:apply upgrades the pin level allows (cron)'
        '-h:help'
      )
      _describe -t commands 'versions subcommand' cmds
    else
      case $words[3] in
      status) _arguments '(--issues)--brief[one line per issue]' '(--brief)--issues[table without the ok rows]' ;;
      auto) _arguments '-n[only print what would be upgraded or held]' ;;
      accept | upgrade | review)
        # Tool names from the .versions next to the dotctl being run.
        local -a tools
        tools=(${(f)"$(awk '!/^[[:space:]]*(#|$)/ { print $1 }' ${words[1]:h}/.versions 2>/dev/null)"})
        [[ $words[3] == accept ]] && tools+=(--all --triaged)
        compadd -a tools
        ;;
      esac
    fi
    ;;
  esac
}

_dotctl "$@"
